# Telegram
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_channel_id_here

# Google Gemini (получить бесплатно на aistudio.google.com/apikey, карта не нужна)
GEMINI_API_KEY=your_gemini_api_key_here

# Источник твитов (RSS/JSON API), опционально — без него fetch_new_posts() работает как заглушка
RSS_SOURCE_URL=

# Путь к локальной SQLite-базе (по умолчанию posts.db)
DB_PATH=posts.db

# Интервал проверки новых постов в минутах (по умолчанию 15)
CHECK_INTERVAL_MINUTES=15
